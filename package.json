{
  "name": "excalidraw-desktop",
  "productName": "Excalidraw",
  "version": "0.1.0",
  "description": "Excalidraw whiteboard + transparent draw-over-your-screen overlay",
  "author": "Sean Ezenwa",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.itsseanez.excalidraw-desktop",
    "productName": "Excalidraw",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**", "package.json"],
    "mac": { "target": ["dir"], "category": "public.app-category.productivity" },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"] }
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "latest",
    "wait-on": "latest"
  }
}
